{
  "name": "kv",
  "version": "0.1.0",
  "description": "Encrypted .env manager with a TUI — sops-style password vault with `kv apply`",
  "type": "module",
  "bin": {
    "kv": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --minify src/index.ts --outfile dist/kv",
    "build:release": "bun run scripts/build-release.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@termuijs/core": "^0.1.7",
    "@termuijs/jsx": "^0.1.7",
    "@termuijs/store": "^0.1.7",
    "@termuijs/tss": "^0.1.7",
    "@termuijs/ui": "^0.1.7",
    "@termuijs/widgets": "^0.1.7",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@termuijs/testing": "^0.1.7",
    "@types/qrcode": "^1.5.6",
    "bun-types": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
