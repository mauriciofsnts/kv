{
  "name": "kv",
  "version": "0.1.0",
  "description": "Encrypted .env manager with a TUI — sops-style password vault with `kv apply`",
  "type": "module",
  "bin": {
    "kv": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --minify src/index.ts --outfile dist/kv",
    "build:release": "bun run scripts/build-release.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-devtools-core": "^7.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "bun-types": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
