#compdef kv

_kv_groups() {
  local -a groups
  groups=(${(f)"$(command kv __complete groups 2>/dev/null)"})
  (( $#groups )) && _describe -t groups 'group' groups
}

_kv_names() {
  local -a names fwd
  local i
  for ((i = 1; i <= $#words; i++)); do
    if [[ $words[i] == -g || $words[i] == --group ]]; then
      fwd=(--group "$words[i+1]")
    fi
  done
  names=(${(f)"$(command kv __complete names $fwd 2>/dev/null)"})
  (( $#names )) && _describe -t secrets 'secret' names
}

_kv_apply_targets() {
  local -a names
  _kv_names
  names=(all)
  _describe -t targets 'target' names
}

_kv() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a group_opt env_opt
  group_opt=('(-g --group)'{-g,--group}'[vault group]:group:_kv_groups')
  env_opt=('(-e --env)'{-e,--env}'[target .env file]:file:_files')

  _arguments -C \
    '(-h --help)'{-h,--help}'[show help]' \
    '1:command:->cmds' \
    '*::arg:->args' && return

  case $state in
    cmds)
      local -a commands
      commands=(
        'init:Create the vault'
        'apply:Fill values into ./.env'
        'run:Run a command with secrets as env vars'
        'scan:Import an existing ./.env into the vault'
        'diff:Show drift between ./.env and the vault'
        'set:Store a secret'
        'get:Print a secret value'
        'list:List groups and names'
        'use:Show or pin the active group for this directory'
        'rm:Remove a secret'
        'alias:Manage alternative names'
        'share:Share a group as an encrypted QR code'
        'import:Import a shared group'
        'lock:End the session'
        'passwd:Change the vault password'
        'config:Show or change persisted settings'
        'vault:Show or change where the vault is stored'
        'help:Show help'
      )
      _describe -t commands 'command' commands
      ;;
    args)
      case $words[1] in
        apply)
          _arguments $group_opt $env_opt \
            '--from[template file]:file:_files' \
            '(-f --force)'{-f,--force}'[overwrite variables that already have a value]' \
            '(-s --safe)'{-s,--safe}'[skip variables that already have a value]' \
            '1:variable:_kv_apply_targets'
          ;;
        get)
          _arguments $group_opt \
            '(-c --copy)'{-c,--copy}'[copy to clipboard]' \
            '1:secret:_kv_names'
          ;;
        set|rm)
          _arguments $group_opt '1:secret:_kv_names'
          ;;
        alias)
          _arguments $group_opt \
            '1:action:(add rm move)' \
            '*:secret:_kv_names'
          ;;
        scan|diff)
          _arguments $group_opt $env_opt
          ;;
        run|list)
          _arguments $group_opt
          ;;
        share|import)
          _arguments $group_opt '1:group:_kv_groups'
          ;;
        use)
          _arguments '1:group:_kv_groups'
          ;;
        config)
          _arguments '1:setting:(force)' '2:value:(on off)'
          ;;
      esac
      ;;
  esac
}

_kv "$@"
